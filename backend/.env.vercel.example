# Vercel backend project variables. Add these in Vercel Project Settings > Environment Variables.
# Do not commit real credentials. DATABASE_URL can also be named POSTGRES_URL.

DJANGO_SECRET_KEY=generate-a-long-random-secret
DEBUG=False
DEVELOPMENT_MODE=False

# Set to the deployed backend domain. VERCEL_URL is added automatically for each deployment.
ALLOWED_HOSTS=your-api-project.vercel.app

# Exact deployed frontend origin(s), comma-separated if needed.
CORS_ALLOWED_ORIGINS=https://your-web-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-web-project.vercel.app

# Use the provider's pooled PostgreSQL connection string and require TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Required for trainee images and uploaded files.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloud-api-key
CLOUDINARY_API_SECRET=your-cloud-api-secret

# Optional email configuration.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=Nadik <noreply@example.com>
ADMIN_EMAIL=admin@example.com
